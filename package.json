{
  "name": "topheman/effect-viz",
  "version": "3.1.1",
  "private": true,
  "description": "Effect runtime visualizer",
  "keywords": [
    "effect",
    "effect-ts",
    "fibers",
    "react",
    "stepper",
    "typescript",
    "visualizer",
    "vite",
    "webcontainer"
  ],
  "homepage": "https://github.com/topheman/effect-viz",
  "bugs": {
    "url": "https://github.com/topheman/effect-viz/issues"
  },
  "license": "MIT",
  "author": "Christophe Rosset",
  "repository": {
    "type": "git",
    "url": "https://github.com/topheman/effect-viz"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm run copy:esbuild-wasm && pnpm run build:runtime && pnpm run build:effect-types && vp dev",
    "build": "pnpm run copy:esbuild-wasm && pnpm run build:runtime && pnpm run build:effect-types && tsc -b && vp build",
    "build:runtime": "vp build --config vite.runtime.config.ts && tsc -p tsconfig.runtime.json && node scripts/extract-dts-from-runtime.mjs --src=dist/runtime > src/effects/app-lib-dts-urls.json && node scripts/copy-runtime.mjs",
    "build:effect-types": "node scripts/extract-effect-dts.mjs",
    "copy:esbuild-wasm": "cp node_modules/esbuild-wasm/esbuild.wasm public/esbuild.wasm",
    "check": "effect-tsgo vp check",
    "lint": "effect-tsgo vp lint",
    "lint:fix": "effect-tsgo vp lint --fix",
    "format": "vp fmt",
    "preview": "vp preview",
    "test": "vp test run",
    "test:watch": "vp test",
    "playwright:install": "playwright install chromium webkit",
    "demo:record": "node scripts/demo/record.ts",
    "e2e": "pnpm run build && playwright test",
    "prepare": "vp config --no-agent"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@webcontainer/api": "^1.6.4",
    "ansi-to-react": "^6.2.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "effect": "4.1.4",
    "esbuild-wasm": "^0.28.2",
    "lucide-react": "^1.70.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.21.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@effect/tsgo": "0.68.1",
    "@playwright/test": "^1.65.0",
    "@rolldown/plugin-babel": "^0.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint-plugin-better-tailwindcss": "^4.10.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "jsdom": "^31.0.0",
    "monaco-editor": "0.55.1",
    "playwright": "^1.65.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "workbox-window": "^7.4.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "26.x"
  }
}
