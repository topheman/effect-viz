{
  "name": "topheman/effect-viz",
  "version": "3.1.0",
  "private": true,
  "description": "Effect runtime visualizer",
  "keywords": [
    "effect",
    "effect-ts",
    "fibers",
    "react",
    "stepper",
    "typescript",
    "visualizer",
    "vite",
    "webcontainer"
  ],
  "homepage": "https://github.com/topheman/effect-viz",
  "bugs": {
    "url": "https://github.com/topheman/effect-viz/issues"
  },
  "license": "MIT",
  "author": "Christophe Rosset",
  "repository": {
    "type": "git",
    "url": "https://github.com/topheman/effect-viz"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm run copy:esbuild-wasm && pnpm run build:runtime && pnpm run build:effect-types && vp dev",
    "build": "pnpm run copy:esbuild-wasm && pnpm run build:runtime && pnpm run build:effect-types && tsc -b && vp build",
    "build:runtime": "vp build --config vite.runtime.config.ts && tsc -p tsconfig.runtime.json && node scripts/extract-dts-from-runtime.mjs --src=dist/runtime > src/effects/app-lib-dts-urls.json && node scripts/copy-runtime.mjs",
    "build:effect-types": "node scripts/extract-effect-dts.mjs",
    "copy:esbuild-wasm": "cp node_modules/esbuild-wasm/esbuild.wasm public/esbuild.wasm",
    "check": "vp check",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt",
    "preview": "vp preview",
    "test": "vp test run",
    "test:watch": "vp test",
    "playwright:install": "playwright install chromium webkit",
    "demo:record": "node scripts/demo/record.ts",
    "e2e": "pnpm run build && playwright test",
    "typecheck:app": "tsc --noEmit -p ./tsconfig.app.json",
    "typecheck:node": "tsc --noEmit -p ./tsconfig.node.json",
    "typecheck:demo": "tsc --noEmit -p ./tsconfig.demo.json",
    "typecheck:e2e": "tsc --noEmit -p ./tsconfig.e2e.json",
    "typecheck:effect": "effect-language-service diagnostics --project tsconfig.app.json --strict",
    "typecheck": "pnpm run typecheck:app && pnpm run typecheck:node && pnpm run typecheck:demo && pnpm run typecheck:e2e && pnpm run typecheck:effect",
    "prepare": "vp config --no-agent"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@webcontainer/api": "^1.6.1",
    "ansi-to-react": "^6.2.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "effect": "3.22.1",
    "esbuild-wasm": "^0.27.3",
    "lucide-react": "^0.563.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-resizable-panels": "^4.5.2",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@effect/language-service": "^0.87.2",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.1.17",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint-plugin-better-tailwindcss": "^3.7.11",
    "eslint-plugin-testing-library": "^7.13.5",
    "jsdom": "^27.2.0",
    "monaco-editor": "0.55.1",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.1.17",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "catalog:",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "workbox-window": "^7.4.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "26.x"
  }
}
