{
  // Oxfmt and Oxlint read the `fmt` and `lint` blocks of vite.config.ts, so the
  // editor and `vp check` agree. The per-language overrides keep a user-level
  // Prettier default from winning over the workspace formatter.
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "[javascript]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[javascriptreact]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[typescript]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[typescriptreact]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "oxc.disableNestedConfig": true,
  "oxc.fmt.disableNestedConfig": true,
  "editor.formatOnSave": true,
  // Oxfmt has no partial-format mode.
  "editor.formatOnSaveMode": "file",
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit"
  },
  // TypeScript 7 and Oxlint through their Effect-patched builds, which add the
  // Effect language service and diagnostics. See CONTRIBUTING.md.
  "js/ts.experimental.useTsgo": true,
  "js/ts.tsdk.path": "scripts/editor",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  "oxc.path.oxlint": "scripts/editor/oxlint.mjs"
}
